ENDLESS_TASK_PROVIDER=deepseek
ENDLESS_TASK_BASE_URL=https://api.deepseek.com
ENDLESS_TASK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=

# Optional
# Agent Runtime 默认选择：v2（默认）或 v1；均允许会话级覆盖。
# ENDLESS_TASK_RUNTIME=v2
# 显式全局回滚：强制所有会话使用 v1，优先级高于会话级 override。
# ENDLESS_TASK_RUNTIME_ROLLBACK=0
# ENDLESS_TASK_CONFIG_VERSION=1
# ENDLESS_TASK_DATA_DIR=~/Library/Application Support/Endless Task
# ENDLESS_TASK_DB_PATH=./data/endless-task.db
# ENDLESS_TASK_PROVIDER_TIMEOUT_SECONDS=60
# ENDLESS_TASK_SUMMARY_TOKEN_LIMIT=1024
# ENDLESS_TASK_SYSTEM_PROMPT_VERSION=p1-v1
# ENDLESS_TASK_MAX_CONCURRENT_MODEL_CALLS=2
# ENDLESS_TASK_MAX_TOOL_CALLS_PER_TURN=8
# ENDLESS_TASK_MAX_CONCURRENT_TOOL_CALLS=4
# ENDLESS_TASK_MAX_TOOL_ARGUMENT_BYTES=65536
# ENDLESS_TASK_MAX_TOTAL_TOOL_ARGUMENT_BYTES=262144
# ENDLESS_TASK_MAX_TOOL_ARGUMENT_DEPTH=32
# ENDLESS_TASK_MAX_TOOL_ARGUMENT_NODES=10000
# ---- 运行时长预算（按运行类别分档，取代原来的单一硬墙） ----
# 一次运行的上限不再是一个全局墙，而是按「运行类别」取；每档都有 soft / hard / 成本上限：
#
#   运行类别      soft（只提请决策，不中断）   hard（优雅收尾）      成本上限
#   interactive   180 秒（3 分钟）             900 秒（15 分钟）     $1
#   task          600 秒（10 分钟）            3600 秒（60 分钟）    $3
#   long          3600 秒（60 分钟）           14400 秒（4 小时）    $10
#
# soft：到点发一条 run_awaiting_user（willStop=false）提请人工决策，**运行继续跑**。
# hard：到点**优雅收尾**——把运行记成 COMPLETED、阶段性结论留在可见正文里，并追加一段
#       「怎么继续」的引导语；汇报里 willStop 为 true。**它不再是失败**：长活到点应该
#       留下可接着推进的成果，而不是 FAILED。
# 三档都可用下面的 env 覆盖（每档各自要求 soft < hard，写反了启动即失败，报错会指名
# 是哪两个变量）：ENDLESS_TASK_INTERACTIVE_SOFT_SECONDS / _HARD_SECONDS / _COST_CAP_USD、
# ENDLESS_TASK_TASK_SOFT_SECONDS / _HARD_SECONDS / _COST_CAP_USD、
# ENDLESS_TASK_LONG_SOFT_SECONDS / _HARD_SECONDS / _COST_CAP_USD。
# 长跑档怎么选中（切片 10 T1）：新增选择器 ENDLESS_TASK_RUN_BUDGET_PROFILE
#   interactive（默认，= 历史行为）| task | long
# 它决定**交互 run**用哪一档；选 long 之后上面 9 个 LONG_* 变量才真正生效
# （在此之前没有任何运行类别会选中长跑档，设了也不影响任何一次运行）。
# 作用域只有交互 run：定时/任务 run 恒用 task 档，委派子运行恒走自己的派生预算。
# ENDLESS_TASK_RUN_BUDGET_PROFILE=interactive
#
# ⚠️ 单轮兜底与 hard 的关系（想把某一档的 hard 配小之前务必读完）：
# 单次模型调用另有兜底上限 = provider_timeout_seconds × (重试次数 + 1) + 30 秒
# （默认 60 × 3 + 30 = **210 秒**）。每轮允许的时长取 min(剩余硬预算, 该兜底值)。
# 所以把某一档的 hard 配得比这个兜底**更小**（例如 ENDLESS_TASK_TASK_HARD_SECONDS=120）
# 时，min() 会等于该档的墙：单次调用先撞墙，provider 自己的超时与内部重试就被提前掐掉。
# 这在语义上**并不是错**（你明确要一个更小的墙，撞到它就是到了本次运行的上限 →
# 优雅收尾），代价是牺牲 provider 的重试。**想保留 provider 的重试，就该让该档的
# hard 高于它的单轮兜底（默认 210 秒）。**
#
# 旧变量（历史兼容）：含义不变，但现在**只覆盖交互式档**——
#   ENDLESS_TASK_AGENT_TIMEOUT_SECONDS = 交互式档的 hard（任务/长跑档不受影响）；
#   ENDLESS_TASK_COST_CAP_USD         = 交互式档的成本上限。
# 没设过这两个变量就用上面的新默认值。注意旧变量没有 soft 这个概念：若它把 hard 压到
# 默认 soft（180 秒）之下甚至相等，我们只在「旧配置覆盖」这条路径上代它收敛 soft
# （相等时取 hard 的一半），避免启动失败。所以「soft/hard 配得不一致就指名报错」只在
# **纯新 env 路径**（没设旧变量）上成立；一旦 ENDLESS_TASK_AGENT_TIMEOUT_SECONDS 也设了，
# 交互式档就以它为准，此时显式写进新 env 的 soft 会被静默夹到它的一半、**不会报错**：
# 例如 AGENT_TIMEOUT_SECONDS=60 加 INTERACTIVE_SOFT_SECONDS=2000，得到的 soft 是 30 秒。
# ENDLESS_TASK_AGENT_TIMEOUT_SECONDS=120
# ENDLESS_TASK_APPROVAL_TIMEOUT_SECONDS=1800
# ENDLESS_TASK_MAX_MESSAGE_CHARACTERS=100000
# ENDLESS_TASK_MAX_FILE_BYTES=1000000
# ENDLESS_TASK_MAX_FILES_PER_CONVERSATION=10
# ENDLESS_TASK_MEMORY_PROPOSALS=1
# 记忆自动写入：0=关闭（默认，全部记忆走提案确认）；1=开启。
# 开启后，提取明确度达到 medium/high 的 fact 记忆直接写入（write_origin=auto_fact），
# preference 与低明确度 fact 仍走提案确认。审查队列：GET /memories?write_origin=auto_fact。
# ENDLESS_TASK_MEMORY_AUTO_FACT=0
# v2 上下文压缩：1=启用（默认）；0=关闭。
# 启用后，模型上下文估算超过窗口 80% 时，把最早的完整轮次固化为 context_summary
# entry（本地提取式摘要，无模型调用），后续投影跳过被覆盖内容。
# ENDLESS_TASK_CONTEXT_COMPACTION=1
# S5 模型侧终端工具（terminal_open/send/read/signal/close/list）：1=注册。
# 默认 0：模型看不到这些工具（避免工具面开销）。开启后 open/send/signal 仍需逐条确认。
# ENDLESS_TASK_TERMINAL_TOOLS=0

# 工具层墙（切片 10 T1）：长活真正被掐断的地方往往不是 run 预算，而是这几条
# 秒级工具墙。三处都可配置，默认值一律与历史行为逐字一致。
# - ENDLESS_TASK_SHELL_TIMEOUT_SECONDS：单条 shell 命令的**总时长墙**（秒，默认 120，
#   上限 600）。内外层**同源**：内层 runner 与外层工具定义（模型面 timeout_seconds）
#   用同一个值——过去外层被类级常量钉死在 120，配成 600 也无效、照样报 tool_timeout。
# - ENDLESS_TASK_SHELL_NO_CHANGE_TIMEOUT_SECONDS：**无输出看门狗**（秒，默认 60）。
#   语义是"多久没有任何 stdout/stderr 就认为卡死"，与总时长墙**是两件事**。
#   0 = 关闭看门狗（合法）；(0, 1) 钳到 1 秒；负数/nan/inf 启动即失败并指名变量。
# - ENDLESS_TASK_CHILD_DEFAULT_TIMEOUT_SECONDS：委派子运行的**默认墙**（秒，默认 120）
#   ——模型在 spawn_agent 里不写 timeoutSeconds 时用它，仍受
#   ENDLESS_TASK_MAX_CHILD_HARD_SECONDS（默认 3600）封顶。
# ENDLESS_TASK_SHELL_TIMEOUT_SECONDS=120
# ENDLESS_TASK_SHELL_NO_CHANGE_TIMEOUT_SECONDS=60
# ENDLESS_TASK_CHILD_DEFAULT_TIMEOUT_SECONDS=120

# S9 终端沙箱：off（默认，本机直跑）/ seatbelt（macOS）/ container。
# 显式开启但沙箱不可用时**拒绝启动**（无静默降级）；workspace-write 语义：
# 只有工作区根内可写，越界写入由 OS 拒绝。
# ENDLESS_TASK_SHELL_SANDBOX=off
# 沙箱网络：deny（默认）/ allow。
# ENDLESS_TASK_SHELL_SANDBOX_NETWORK=deny
# container 模式必填镜像（需本机有 docker）。
# ENDLESS_TASK_SHELL_SANDBOX_IMAGE=

# S8 只读命令信任：1=开启（默认 0，行为不变：所有 run_shell 命令逐条确认）。
# 开启后仅"确定只读"的命令（ls/git status/grep 等，且不含重定向、管道到解释器、
# 命令替换、sudo 等构造）免确认；危险命令（rm/curl/chmod 等）恒确认。
# ENDLESS_TASK_SHELL_TRUST_READONLY=0

# S8 额外信任前缀（逗号分隔，仅在 READONLY 开关开启时生效）。
# 每一段命令都必须命中前缀才放行，例如 "pytest,npm test"。
# ENDLESS_TASK_SHELL_TRUSTED_PREFIXES=

# Agent Platform v2 工具路径（AP-107 后默认开；非法值启动失败）
# ENDLESS_TASK_TOOL_PLATFORM_V2=1
# M2 Context Engine v2 cutover（默认开：仅预算紧张时修剪初始历史；预算充足=legacy 一致）
# ENDLESS_TASK_CONTEXT_ENGINE_V2=1

# ---------- R5.8 语义混合检索（嵌入） ----------
# 总开关：0=关闭（纯字面检索，默认）；1=启用。
# 启用后检索走「字面 + 向量」加权融合，换说法的查询也能命中知识。
# ENDLESS_TASK_EMBEDDING=0

# 嵌入后端：
#   local    = 本地 ONNX 小模型（默认）。首次启用时一次性下载模型
#              （bge-small-zh-v1.5，约 90MB）到
#              ~/Library/Application Support/Endless Task/models/，
#              之后纯 CPU 离线推理，数据不出机。
#   provider = 走 OpenAI 兼容网关的 /embeddings 接口（需网关支持，
#              且必须同时配置 ENDLESS_TASK_EMBEDDING_MODEL 与 provider API key；
#              openai-compatible 还需 ENDLESS_TASK_BASE_URL）。
# ENDLESS_TASK_EMBEDDING_BACKEND=local

# provider 后端使用的嵌入模型名（仅 backend=provider 时必填）。
# ENDLESS_TASK_EMBEDDING_MODEL=

# local 后端的模型来源仓库（HuggingFace 格式，需含 onnx/model.onnx 与
# tokenizer.json）。默认用 bge-small-zh-v1.5 的 ONNX 移植仓库。
# ENDLESS_TASK_EMBEDDING_LOCAL_REPO=Xenova/bge-small-zh-v1.5

# 模型下载源地址。离线/内网环境可指向自建镜像（文件布局需与 HF 一致）。
# ENDLESS_TASK_EMBEDDING_LOCAL_URL_BASE=https://huggingface.co

# 单条待嵌入文本的最大字符数（知识源/记忆/成果/轮次超出部分截断）。
# ENDLESS_TASK_EMBEDDING_MAX_CHARS=1500

# 全量重建（endless-task embeddings rebuild）时的批量嵌入大小。
# ENDLESS_TASK_EMBEDDING_BATCH=8

# 可选：用 sqlite-vec 做本地向量 KNN（未安装 sqlite-vec 时自动回退暴力算距离）。
# 需先 `uv pip install sqlite-vec`（或 `uv pip install -e '.[vec]'`）。
# ENDLESS_TASK_SQLITE_VEC=0

# 混合检索融合权重：字面,语义（默认 0.4,0.6）。
# 最终分 = 字面权重×归一化字面分 + 语义权重×余弦相似度。
# 调高语义权重更容忍换说法查询；设为 1.0,0.0 可退回纯字面排序。
# ENDLESS_TASK_KNOWLEDGE_HYBRID_WEIGHTS=0.4,0.6

# ---- R5.10 知识生命周期 ----

# 重复判定阈值：新源与存量源的字符三元组 Jaccard 重叠达到该值即出合并提案（0–1）。
# ENDLESS_TASK_KNOWLEDGE_DUPLICATE_THRESHOLD=0.5

# 衰减确认总开关（1/0）。关闭后不出「是否仍有效」确认提案。
# ENDLESS_TASK_KNOWLEDGE_DECAY=1

# 衰减判定窗口（天）：创建超过该天数且期间零注入命中才会出确认提案。
# ENDLESS_TASK_KNOWLEDGE_DECAY_MIN_AGE_DAYS=30

# 衰减复核冷却（天）：用户对某源的确认提案处理过（含拒绝）后，该窗口内不再问。
# ENDLESS_TASK_KNOWLEDGE_DECAY_RECHECK_DAYS=90

# 衰减巡检间隔（小时）：API 启动 5 分钟后首轮补偿检查，此后按该间隔循环。
# ENDLESS_TASK_KNOWLEDGE_DECAY_INTERVAL_HOURS=24

# 引用反馈权重开关（1/0）：角标点击/忽略聚合为排序因子（仅知识源作用域）。
# ENDLESS_TASK_KNOWLEDGE_FEEDBACK=1

# ---- C1 制造者—检查者分离（独立验证） ----

# 独立验证模式：0 关（默认）/ 1 所有运行 / side_effects 仅有副作用的关键运行。
# 验证器使用独立 prompt 与独立上下文（不看制造者历史/推理）。
# ENDLESS_TASK_VERIFIER=0

# 可选：验证器使用不同模型（留空 = 与主模型相同，上下文仍完全隔离）。
# ENDLESS_TASK_VERIFIER_MODEL=

# ---- 上下文窗口与输出预算（A2/C3） ----

# 上下文窗口（tokens）。默认 131072（128K）；DeepSeek V4 系列实测上限 1,048,576。
# 推荐：个人日常 131072；长任务 262144；极限 524288（需配合成本上限与上下文缓存）。
# ENDLESS_TASK_CONTEXT_WINDOW_TOKENS=131072

# 单次输出上限（tokens）。默认 4096；长报告可提到 8192（会挤压可用输入预算）。
# ENDLESS_TASK_MAX_OUTPUT_TOKENS=4096

# ---- B1 记忆时间衰减 / 近期性偏置 ----

# 近期性占比（0–1）：0 = 纯相关性（默认，行为不变），1 = 纯近期性。
# 排序分 = (1-w)·相关性 + w·exp(-age_days/τ)。
# ENDLESS_TASK_MEMORY_RECENCY_WEIGHT=0.3

# 衰减时间常数 τ（天）：越大衰减越慢（默认 30）。
# ENDLESS_TASK_MEMORY_DECAY_TAU=30

# ---- B3 重要性加权遗忘 / 间隔重复 ----

# 是否周期巡检并遗忘低价值记忆（默认 0 = 关闭，不自动动用户记忆）。
# 重要记忆（importance ≥ 0.7）只会进入"待确认"，不会被静默删除；钉住的永不遗忘。
# ENDLESS_TASK_MEMORY_FORGETTING=0

# 巡检间隔（小时，默认 24）。
# ENDLESS_TASK_MEMORY_FORGETTING_INTERVAL_HOURS=24

# 每轮最多遗忘多少条（默认 10）。
# ENDLESS_TASK_MEMORY_FORGETTING_MAX_PER_RUN=10

# ---- B2 记忆巩固 ----

# 相似度阈值（0–1，默认 0.5）：字符三元组 Jaccard 达到该值即视为同类可合并。
# ENDLESS_TASK_MEMORY_CONSOLIDATION_THRESHOLD=0.5

# 每次巩固最多产出多少条合并提案（默认 3）。
# ENDLESS_TASK_MEMORY_CONSOLIDATION_MAX_PER_RUN=3

# ---- B4 反思 ----

# 终态运行（含失败）自动归纳洞见并走记忆提案确认（默认 1 = 开）。
# ENDLESS_TASK_MEMORY_REFLECTION=1

# ---- C5 成本/延迟可见 ----

# 单次运行的估算成本上限（USD，0 = 不限制）；超限走 C4 升级提示（不自动停止）。
# 旧变量：含义不变，但**只覆盖交互式档**的成本上限（任务/长跑档见上方「运行时长预算」块）。
# ENDLESS_TASK_COST_CAP_USD=0.05

# ---- C4 终止与升级 ----

# 上下文用量达到该比例（(0,1]）即提请人工决策（默认 0.85）。
# ENDLESS_TASK_ESCALATION_BUDGET_RATIO=0.85
